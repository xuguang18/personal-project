<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.personal</groupId>
        <artifactId>personal-project</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>personal-ai</artifactId>
    <name>personal-ai</name>
    <description>AI 应用模块：LLM 调用、RAG、Embedding 等</description>

    <!--
        按需引入 AI 框架（二选一或都用）：
        1. Spring AI（版本由独立的 spring-ai-bom 管理，与 Spring Boot 版本有对应要求，引入前先查兼容性矩阵）：
           <dependencyManagement>
               <dependencies>
                   <dependency>
                       <groupId>org.springframework.ai</groupId>
                       <artifactId>spring-ai-bom</artifactId>
                       <version>${spring-ai.version}</version>
                       <type>pom</type>
                       <scope>import</scope>
                   </dependency>
               </dependencies>
           </dependencyManagement>
           <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-openai</artifactId>
           </dependency>
        2. LangChain4j（独立版本，需自行指定 version）：
           <dependency>
               <groupId>dev.langchain4j</groupId>
               <artifactId>langchain4j-open-ai</artifactId>
               <version>${langchain4j.version}</version>
           </dependency>
    -->

</project>
